# Laravel runtime env file loaded by containers.
# Keep APP_KEY and third-party secrets in this file (or another secure env file).
APP_ENV_FILE=.env.production

# Public hostnames resolved by Nginx.
LANDING_HOST=boardmasters.com
API_HOST=api.boardmasters.com
ADMIN_HOST=app.boardmasters.com
NGINX_SERVER_NAMES=boardmasters.com api.boardmasters.com app.boardmasters.com
CERT_DOMAIN=boardmasters.com
APP_URL=https://boardmasters.com
APP_LANDING_URL=https://boardmasters.com
APP_API_URL=https://api.boardmasters.com
APP_API_ALLOWED_URLS=https://api.boardmasters.com
APP_ADMIN_URL=https://app.boardmasters.com

# Public port mapping on the target host.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# MySQL credentials.
DB_DATABASE=app_review_center
DB_USERNAME=boardmasters
DB_PASSWORD=change-this
DB_ROOT_PASSWORD=change-root-password

# Optional phpMyAdmin host port (only when --profile tools is enabled).
PMA_PORT=8081

# Startup toggles.
RUN_MIGRATIONS=false
RUN_CONFIG_CACHE=true
LOG_CHANNEL=stderr
