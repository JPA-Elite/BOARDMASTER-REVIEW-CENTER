# Compose file to run for the app container environment variables.
APP_ENV_FILE=.env

# Local hostnames and host port for Nginx.
LANDING_HOST=boardmasters.local
API_HOST=api.boardmasters.local
ADMIN_HOST=app.boardmasters.local
NGINX_SERVER_NAMES=boardmasters.local api.boardmasters.local app.boardmasters.local
NGINX_HTTP_PORT=8080
APP_URL=http://boardmasters.local:8080
APP_LANDING_URL=http://boardmasters.local:8080
APP_API_URL=http://api.boardmasters.local:8080
APP_ADMIN_URL=http://app.boardmasters.local:8080
VITE_PORT_FORWARD=5173
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_HMR_HOST=app.boardmasters.local
VITE_ALLOWED_ORIGINS=http://boardmasters.local:8080,http://api.boardmasters.local:8080,http://app.boardmasters.local:8080
VITE_USE_POLLING=true
VITE_POLL_INTERVAL=600
VITE_BACKEND_URL=http://web
VITE_DEV_SERVER_URL=http://app.boardmasters.local:8080

# MySQL credentials used by both Laravel containers and MySQL.
DB_DATABASE=app_review_center
DB_USERNAME=boardmasters
DB_PASSWORD=boardmasters
DB_ROOT_PASSWORD=boardmasters_root
MYSQL_PORT_FORWARD=3306

# phpMyAdmin host port.
PMA_PORT=8081

# Container startup toggles.
RUN_MIGRATIONS=true
RUN_CONFIG_CACHE=false

# App runtime flags.
APP_ENV=local
APP_DEBUG=true
LOG_CHANNEL=stderr
