APP_NAME='BoardMasters Review Center'
APP_ENV=local
APP_KEY=base64:dX8JqLV1dQKl7otmkQrCp8j+8ECsFKCmNVrRBapOsOg=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_RESET_TOKEN_EXPIRE=30

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_review_center
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_SESSION_TOKEN=

# Upload behavior:
# - APP_ENV=local   -> stores uploads on local/public disk
# - APP_ENV!=local  -> stores uploads on S3 disk
UPLOAD_MAX_FILE_KB=10240
UPLOAD_IMAGE_QUALITY=75
UPLOAD_LOCAL_DISK=public
UPLOAD_REMOTE_DISK=s3

VITE_APP_NAME="${APP_NAME}"

# Google Sign-In (mobile API):
# Put your OAuth Client IDs here (Web/Android/iOS as needed), separated by commas.
# Example: GOOGLE_AUTH_AUDIENCES=123-web.apps.googleusercontent.com,123-android.apps.googleusercontent.com
GOOGLE_AUTH_AUDIENCES=166616643070-cu88d2jpq3mhk4t0nn8p93cv9mgvg4q7.apps.googleusercontent.com

# Apple Sign-In (mobile API):
# Usually your app bundle identifier(s), comma-separated if you support multiple.
# Example: APPLE_AUTH_AUDIENCES=ph.boardmaster.appReviewCenter
APPLE_AUTH_AUDIENCES=ph.boardmaster.appReviewCenter

PAYMONGO_MODE=test
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# Test account credentials
PAYMONGO_TEST_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_TEST_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_TEST_WEBHOOK_SECRET=whsk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Live account credentials
PAYMONGO_LIVE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_LIVE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMONGO_LIVE_WEBHOOK_SECRET=whsk_live_xxxxxxxxxxxxxxxxxxxxxxxx

PAYMONGO_SUCCESS_URL="${APP_URL}/payments/success"
PAYMONGO_CANCEL_URL="${APP_URL}/payments/cancel"
PAYMONGO_DEFAULT_PAYMENT_METHODS=card,gcash,grab_pay,paymaya,qrph
PAYMONGO_TIMEOUT=30
PAYMONGO_WEBHOOK_TOLERANCE=300
